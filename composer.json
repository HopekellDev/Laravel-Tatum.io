{
    "name": "hopekelldev/laravel-tatum-io",
    "description": "Modern Laravel SDK for selected Tatum.io APIs.",
    "keywords": [
        "laravel",
        "tatum",
        "crypto",
        "blockchain",
        "web3",
        "wallet",
        "erc20",
        "erc721",
        "erc1155"
    ],
    "homepage": "https://github.com/hopekelldev/laravel-tatum-io",
    "license": "MIT",
    "type": "library",

    "authors": [
        {
            "name": "Hopekell Technologies",
            "email": "info@hopekelltech.com"
        }
    ],

    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0"
    },

    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0"
    },

    "autoload": {
        "psr-4": {
            "HopekellDev\\Tatum\\": "src/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "HopekellDev\\Tatum\\Tests\\": "tests/"
        }
    },

    "extra": {
        "laravel": {
            "providers": [
                "HopekellDev\\Tatum\\TatumServiceProvider"
            ],
            "aliases": {
                "Tatum": "HopekellDev\\Tatum\\Facades\\Tatum"
            }
        }
    },

    "minimum-stability": "stable",
    "prefer-stable": true,

    "scripts": {
        "test": "vendor/bin/phpunit"
    },

    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}